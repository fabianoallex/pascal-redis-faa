# saidas de compilacao
build/
lib/
backup/
*.exe
*.o
*.a
*.ppu
*.rsj
*.compiled
*.dcu
Win32/
Win64/
linux/

# recurso .res gerado pelo IDE (icone padrao) - regeneravel
*.res

# binarios ELF (sem extensao) gerados por lazbuild em Linux no proprio diretorio
samples/SmokeTest/SmokeTest
samples/CacheAsideVcl/CacheAsideVcl
tests/Unit/fpc/RedisUnitTestsFpc

# certificados do servidor TLS de dev (gerar localmente; ver docker/certs/README.md)
docker/certs/*.crt
docker/certs/*.key

# relatorio NUnit gerado pelo runner DUnitX
dunitx-results.xml

# arquivos de sessao/IDE
*.lps
*.local
*.identcache
*.stat
__history/
__recovery/

# saidas de tools/test_fpc.sh (log de build e de execucao, resumo do heaptrc)
tests/*/fpc/build.log
tests/*/fpc/run.log
tests/*/fpc/heap.txt

# copia da lista de pacotes do Lazarus que o lazbuild larga no diretorio corrente
# ao compilar um .lpk com dependencia nao resolvida (pascal_common_faa sem registro)
/packagefiles.xml
